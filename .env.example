DATABASE_URL=sqlite:///./stockresearch.db

# ── 大模型（本机自用，勿提交）────────────────────────────────────────────
# 推荐：在应用「设置」(F5) 中填写并保存，会自动写入本 .env 文件。
# 也可手动编辑下方变量。
# DeepSeek 示例：
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# DashScope 兼容模式示例：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 无 Key 演示时设为 true；有真实 Key 时设为 false
USE_MOCK_LLM=true

# 本机访问大模型 API 时的 HTTP 代理（如 http://127.0.0.1:7890）
LLM_HTTP_PROXY=

# ── 博查 AI 联网搜索（新闻兜底）──────────────────────────────────────────
# 申请地址：https://open.bochaai.com
# 留空时新闻兜底将跳过联网搜索，仅使用 AkShare/东方财富本地源。
BOCHA_API_KEY=

# ── 提示词外置目录 ───────────────────────────────────────────────────────
# 默认读取项目根目录 prompts/；留空时回退到 src/stockresearch/prompts/ 内置提示词。
PROMPTS_DIR=

# ── 调度器运行位置 ───────────────────────────────────────────────────────
# P1 推荐 false：简报/价格告警在独立 worker 进程运行（stockresearch worker）。
# 仅本地单进程开发时可设为 true，让 API 进程也启动调度器。
RUN_SCHEDULERS_IN_API=false

# ---- Kimi Datasource(可选,需本机已安装并 /login  kimi CLI)----
# 是否启用 Kimi 数据源预取与查询(按次消耗 Kimi Code 会员配额)
# KIMI_CLI_ENABLED=false
# kimi CLI 路径(在 PATH 中则保持默认)
# KIMI_CLI_PATH=kimi
# 单次 CLI 调用超时(秒)
# KIMI_CLI_TIMEOUT_SECONDS=120
# 每日用户触发实时调用上限(P3 启用)
# KIMI_LIVE_MAX_CALLS_PER_DAY=20
