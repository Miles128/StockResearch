DATABASE_URL=sqlite:///./stockresearch.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me-in-production
# 生产/Cloudflare：留空，由用户在浏览器「设置」中填写，经请求头传给 API
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 本机后端访问大模型 API 时的 HTTP 代理（终端/VPN 不通时填写，如 http://127.0.0.1:7890）
LLM_HTTP_PROXY=
USE_MOCK_LLM=true
USE_MOCK_MARKET_DATA=false
